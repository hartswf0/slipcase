etract<\/text>\n<circle cx=\"86.8\" cy=\"386.8\" r=\"5\" fill=\"#fff\" stroke=\"#111\"/>\n<text x=\"96.8\" y=\"390.8\" font-family=\"system-ui\" font-size=\"11\" fill=\"#333\">20260921-there-is-a-timed-coordinate-sam<\/text>\n<circle cx=\"762.4\" cy=\"349.8\" r=\"5\" fill=\"#fff\" stroke=\"#111\"/>\n<text x=\"772.4\" y=\"353.8\" font-family=\"system-ui\" font-size=\"11\" fill=\"#333\">20260921-wittgenstein-child-throwing-bal<\/text>\n<text x=\"20\" y=\"982\" font-family=\"system-ui\" font-size=\"12\" fill=\"#555\">SLIPCASE-PROMPT-LANGUAGE-GAME-20260921 · zettel black · platform ring · ghost small ring · concept gray<\/text><\/svg>", "source_pdf_meta": {"name": "What Is a Prompt A Language-Game (the meme cut).pdf", "mime": "application/pdf", "element_id": "source-pdf-b64"}};let mode='deck';const L=document.getElementById('list'),V=document.getElementById('view'),Q=document.getElementById('q');function esc(s){return String(s??'').replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]))}function dlB64(name,mime,b64){const a=document.createElement('a');a.href='data:'+mime+';base64,'+b64;a.download=name;a.click()}function sourcePdfB64(){return document.getElementById(D.source_pdf_meta.element_id).textContent.trim()}function dlText(name,text){const a=document.createElement('a');const u=URL.createObjectURL(new Blob([text],{type:'text/plain'}));a.href=u;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(u),1000)}function setMode(m){mode=m;document.querySelectorAll('header button').forEach(b=>b.classList.toggle('active',b.dataset.mode===m));if(m==='deck')renderDeck();if(m==='paper')showPaper();if(m==='graph')showGraph();if(m==='sources')showSources();if(m==='bib')showBib();if(m==='ghosts')showGhosts();if(m==='mocs')showMocs();if(m==='trail')showTrail();if(m==='prompts')showPrompts();if(m==='rebuild')showRebuild()}function renderDeck(){mode='deck';let q=Q.value.toLowerCase();let cs=D.cards.filter(c=>!q||(c.title+' '+c.source+' '+c.payload).toLowerCase().includes(q));L.innerHTML=cs.map(c=>`<span class=item onclick="showCard('${c.id}')"><b>${String(c.order).padStart(3,'0')}</b> ${esc(c.title)}<div class=small>${esc(c.id)}</div></span>`).join('');V.innerHTML=`<h1>The research desk</h1><p class=notice>This sendable replication capsule embeds all 18 admitted immutable zettel payloads, three consequential prompts, graph data, source/bibliography views, the paper, the paper source map, reconstruction code, the manifest, and the 41-page uploaded proposal PDF. Earlier parent zettels remain ghosts rather than being silently reconstructed.</p><pre>${esc(D.map_text)}</pre>`}function showCard(id){let c=D.cards.find(x=>x.id===id);let target='zettel:'+c.sha256;let back=D.relations.filter(r=>r.type==='BACKLINK'&&r.source===target);V.innerHTML=`<h1>${esc(c.title)}</h1><div class=small>${esc(c.id)}<br>SHA-256 ${c.sha256}<br>${esc(c.filename)}</div><h2>Source</h2><p>${esc(c.source)}</p><h2>Backlinks</h2><p>${back.length?back.map(b=>'<span class=badge>'+esc(b.source_card)+'</span>').join(''):'None within admitted set'}</p><h2>Immutable payload</h2><pre>${esc(c.payload)}</pre>`}function showPaper(){L.innerHTML='<span class=item onclick="showPaper()">Working paper</span><span class=item onclick="showSourceMap()">SOURCE MAP</span><span class=item onclick="showPaperHistory()">MAKING HISTORY</span>';V.innerHTML=`<h1>The Prompt Does Not Contain Its Own Force</h1><p><b>Distributed Specification, Commitment, and Repair in Language-Controlled Systems</b></p><div class=toolbar><button onclick="dlB64(D.paper.pdf_name,'application/pdf',D.paper.pdf_b64)">Download PDF</button><button onclick="dlText('prompt-does-not-contain-its-own-force__2026-09-21.tex',D.paper.tex)">Download TeX</button></div><div class=papertext>${esc(D.paper.text)}</div>`}function showSourceMap(){V.innerHTML='<h1>Paper source map</h1><pre>'+esc(D.paper.source_map)+'</pre>'}function showPaperHistory(){V.innerHTML='<h1>Paper making history</h1><pre>'+esc(D.paper.making_history)+'</pre>'}function showGraph(){L.innerHTML='<span class=item>NETWORK embedded</span><span class=item>Native + ghost field</span>';V.innerHTML='<h1>Network</h1><p class=small>Admitted field. Parent addresses without admitted payloads remain ghosts.</p><div class=svgwrap>'+D.network_svg+'</div>'}function showSources(){L.innerHTML=D.resources.map((r,i)=>`<span class=item onclick="sourceDetail(${i})">${esc(r.name)}<div class=small>${r.state}</div></span>`).join('');V.innerHTML=`<h1>Sources and resources</h1><p>The uploaded proposal PDF is embedded as inert base64 text in this HTML and is decoded only when requested.</p><button onclick="dlB64(D.source_pdf_meta.name,D.source_pdf_meta.mime,sourcePdfB64())">Recover 41-page source PDF</button>`}function sourceDetail(i){let r=D.resources[i];V.innerHTML=`<h1>${esc(r.name)}</h1><pre>${esc(JSON.stringify(r,null,2))}</pre>`}function showBib(){L.innerHTML='';V.innerHTML='<h1>Bibliography</h1><pre>'+esc(D.bibliography_text)+'</pre>'}function showGhosts(){let gs=D.nodes.filter(n=>n.type==='GHOST');L.innerHTML=gs.map(g=>`<span class=item>[[${esc(g.label)}]]<div class=small>${g.inbound_occurrences||0} recorded relation scan(s)</div></span>`).join('');V.innerHTML='<h1>Ghosts</h1><p>Ghosts are preserved unresolved intellectual addresses. They are not treated as missing errors or silently fuzzy-matched.</p>'+gs.map(g=>'<div class=ghost><b>[['+esc(g.label)+']]</b></div>').join('')}function showMocs(){let es=Object.entries(D.mocs);L.innerHTML=es.map(([n,t],i)=>`<span class=item onclick="showMoc(${i})">${esc(n)}</span>`).join('');V.innerHTML='<h1>MOCs</h1><p>Derived constellation views. Evidence remains in root cards.</p>'}function showMoc(i){let e=Object.entries(D.mocs)[i];V.innerHTML='<h1>'+esc(e[0])+'</h1><pre>'+esc(e[1])+'</pre>'}function showTrail(){let es=Object.entries(D.arrangements);L.innerHTML=es.map(([n,t],i)=>`<span class=item onclick="showArr(${i})">${esc(n)}</span>`).join('');V.innerHTML='<h1>Arrangements / trails</h1>'}function showArr(i){let e=Object.entries(D.arrangements)[i];V.innerHTML='<h1>'+esc(e[0])+'</h1><pre>'+esc(e[1])+'</pre>'}function showPrompts(){let es=Object.entries(D.prompts);L.innerHTML=es.map(([n,t],i)=>`<span class=item onclick="showPrompt(${i})">${esc(n)}</span>`).join('');V.innerHTML='<h1>Prompts</h1><p>Exact consequential prompt bodies are embedded here.</p>'}function showPrompt(i){let e=Object.entries(D.prompts)[i];V.innerHTML='<h1>'+esc(e[0])+'</h1><pre>'+esc(e[1])+'</pre>'}function showRebuild(){L.innerHTML='<span class=item onclick="showManifest()">MANIFEST</span><span class=item onclick="showVerification()">VERIFICATION</span><span class=item onclick="showReturn()">RETURN PATH</span>';V.innerHTML=`<h1>Rebuild</h1><pre>${esc(D.rebuild)}</pre><button onclick="dlText('reconstruct_cards.py',D.reconstruct_script)">Download reconstruct_cards.py</button><button onclick="dlText('ZETTELS.json',JSON.stringify(D.cards,null,2))">Download embedded card records</button>`}function showManifest(){V.innerHTML='<h1>Manifest</h1><pre>'+esc(JSON.stringify(D.manifest,null,2))+'</pre>'}function showVerification(){V.innerHTML='<h1>Verification</h1><pre>'+esc(D.verification)+'</pre>'}function showReturn(){V.innerHTML='<h1>Return path</h1><pre>'+esc(D.return_path)+'</pre>'}setMode('deck');</script><script id="source-pdf-b64" type="application/octet-stream">