"MYCELIUM-SOLE-008" [shape=box, style="rounded", label="001 Self-organization is produced by moving the teacher into the environment."];
"BLACK-MOUNTAIN-SOLE-001" [shape=box, style="rounded", label="002 Black Mountain borrowed the SOLE name before it inherited the Black Mountain lineage."];
"MYCELIUM-SOLE-CONFLICT-009" [shape=box, style="rounded", label="003 Self-organization may run on managed conflict rather than spontaneous harmony."];
"SOLE-SEED-010" [shape=box, style="rounded", label="004 A self-organizing learning system can exhaust novelty and require an alien seed."];
"SOLE-BACKEND-011" [shape=box, style="rounded", label="005 The minimally invasive teacher may survive as a systems administrator behind the wall."];
"SOLE-HIDDEN-OBJECTIVE-012" [shape=box, style="rounded", label="006 Self-directed learning can preserve the objective by hiding it from the learner."];
"SOLE-PERFORMED-IGNORANCE-013" [shape=box, style="rounded", label="007 The mediator's useful operation may be performed inferiority."];
"SOLE-FRIENDSHIP-CURRENCY-014" [shape=box, style="rounded", label="008 The Hole-in-the-Wall children turned knowledge inequality into a friendship economy."];
"SOLE-FRACTAL-VISION-015" [shape=box, style="rounded", label="009 Mitra's strangest theory of minimal intervention comes from cellular automata, not pedagogy."];
"SOLE-NONUSER-016" [shape=box, style="rounded", label="010 The Hole in the Wall produced self-organizing learners and a population that would not touch the machine."];
