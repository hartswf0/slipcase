ndacfea6b84d1 [label="A world needs doors",shape=ellipse,style="filled",fillcolor="#eeeeea"];
nd20cb8677ee1 [label="Do not mistake a component for the system",shape=ellipse,style="filled",fillcolor="#eeeeea"];
