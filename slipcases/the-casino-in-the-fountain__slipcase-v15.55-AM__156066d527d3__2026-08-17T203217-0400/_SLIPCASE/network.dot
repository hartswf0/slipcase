digraph G {
graph [overlap=prism,splines=true,outputorder=edgesfirst,bgcolor="white"];
node [fontname="Helvetica",fontsize=7,style="filled",fillcolor="white",color="#444444"];
edge [color="#aaaaaa",penwidth=.5,arrowsize=.35];
nc612fb731050 [label="RNG-001\n“True randomness” becomes a regulatory threshold called “acceptable randomness.”",shape=box,style="rounded,filled",fillcolor="white"];
nf840664a5a6b [label="RNG-002\nA fair game requires a second operation after randomness: random numbers must be mapped into outcomes.",shape=box,style="rounded,filled",fillcolor="white"];
n53bc0f02633b [label="RNG-003\nThe RNG seed and the game’s return-to-player percentage belong to different mechanisms.",shape=box,style="rounded,filled",fillcolor="white"];
na7f72f623ae1 [label="CASINO-ARCH-001\nAn online casino decomposes into components that each transform a different kind of state.",shape=box,style="rounded,filled",fillcolor="white"];
na161989e942c [label="PLATFORM-001\nA new interface channel can change while the game engine remains the same.",shape=box,style="rounded,filled",fillcolor="white"];
n4603f822a6de [label="TEST-001\nSimulation testing does not test “the game” at once; it tests whether one statistical consequence falls inside an acceptable range.",shape=box,style="rounded,filled",fillcolor="white"];
n7e3ffdaeb239 [label="KANEVA-DIM-001\nKaneva treated 2D and 3D as alternate interfaces onto one social world rather than as separate destinations.",shape=box,style="rounded,filled",fillcolor="white"];
na6976645f680 [label="KANEVA-MEDIA-001\nKaneva did not merely embed YouTube; it converted a web media object into an object located inside a room.",shape=box,style="rounded,filled",fillcolor="white"];
nb72aaf1ea7de [label="KANEVA-BOUNDARY-001\nKaneva's world was designed around ingress: the world remained alive by admitting things that were not produced inside it.",shape=box,style="rounded,filled",fillcolor="white"];
ndc1c1979865b [label="KANEVA-HOUSE-001\nIn Kaneva, the virtual house begins to look less like simulated shelter than a spatial operating system for media and identity.",shape=box,style="rounded,filled",fillcolor="white"];
ne526698c9269 [label="KANEVA-WORLD-001\nKaneva suggests that “entering the world” and “accessing the world” are different operations.",shape=box,style="rounded,filled",fillcolor="white"];
na0db2ca76b69 [label="HUBS-URL-001\nMozilla Hubs made the URL itself into a door to a 3D world.",shape=box,style="rounded,filled",fillcolor="white"];
n332965012a20 [label="HUBS-MEDIA-002\nIn Hubs, pasting a URL could manufacture a manipulable object.",shape=box,style="rounded,filled",fillcolor="white"];
n0d2b46c01d2b [label="HUBS-DEATH-003\nMozilla could close Hubs without making the Hubs code cease to exist.",shape=box,style="rounded,filled",fillcolor="white"];
naaedca6e18d6 [label="METAVERSE-DIM-004\nThe metaverse may be representation-independent: 2D and 3D can be clients of the same world.",shape=box,style="rounded,filled",fillcolor="white"];
nab83e6ea4bd2 [label="ROBLOX-LAW-005\nRoblox compiles jurisdiction, age, and platform policy into runtime variables.",shape=box,style="rounded,filled",fillcolor="white"];
nfb9502ed5b36 [label="ROBLOX-RANDOM-006\nRoblox does not regulate “randomness” uniformly: paid randomness can be conditional while advertising rewards must be predetermined.",shape=box,style="rounded,filled",fillcolor="white"];
na81340adb7e4 [label="MINECRAFT-MONEY-007\nMinecraft protects the boundary of a server by forbidding its virtual currency from crossing it.",shape=box,style="rounded,filled",fillcolor="white"];
n86a68d4758a0 [label="LOOTBOX-BORDER-008\nFor UK gambling law, the border between game and world can determine whether a loot box counts as gambling.",shape=box,style="rounded,filled",fillcolor="white"];
n0e59e0f8624a [label="LOOTBOX-EVIDENCE-009\nThe central loot-box evidence problem may be that the platform possesses the experiment while researchers possess only observations.",shape=box,style="rounded,filled",fillcolor="white"];
nb47b7c8685e1 [label="XSOLLA-EXOSKELETON-010\nXsolla's Web Shop lets the purchase leave the game while the purchased object stays inside it.",shape=box,style="rounded,filled",fillcolor="white"];
n6297dadbd3ef [label="XSOLLA-PORTAL-011\nXsolla Metasites translates the hyperlink graph into a portal graph.",shape=box,style="rounded,filled",fillcolor="white"];
neda4febbbc37 [label="XSOLLA-ROBLOX-012\nThe hidden boundary of Roblox becomes visible on the credit-card statement: “Xsolla*Roblox.”",shape=box,style="rounded,filled",fillcolor="white"];
nff47f87b57fe [label="XSOLLA-MINECRAFT-013\nA Minecraft server can acquire a second body on the web: server in 3D, commercial identity in 2D.",shape=box,style="rounded,filled",fillcolor="white"];
n36f37fc1527b [label="GAMBLING-TOPOLOGY-014\nThe casino is not the building: gambling is a topology of value, chance, and payout that can wear any architecture.",shape=box,style="rounded,filled",fillcolor="white"];
n6350552500e6 [label="SECOND-LIFE-JURISDICTION-015\nSecond Life turns legal jurisdiction into literal geography: some avatars are not permitted to enter the region.",shape=box,style="rounded,filled",fillcolor="white"];
n848fb5d31a47 [label="SECOND-LIFE-NOVELTY-016\nA worthless virtual object can legalize a chance mechanic by failing to become money.",shape=box,style="rounded,filled",fillcolor="white"];
n21ce33704ab0 [label="ROBLOX-MARBLE-017\nRoblox's marble fountain turns a randomized transaction into a tiny piece of world physics.",shape=box,style="rounded,filled",fillcolor="white"];
n72e54b281226 [label="ROBLOX-CASHOUT-018\nRoblox's value membrane is asymmetric: player money can enter a random-item economy while creator earnings can leave as dollars.",shape=box,style="rounded,filled",fillcolor="white"];
n74b0b836c24e [label="XSOLLA-RANDOM-FLAG-019\nXsolla turns gambling-adjacentness into catalog metadata: “Mark as paid randomized reward.”",shape=box,style="rounded,filled",fillcolor="white"];
nb375a5247af1 [label="XSOLLA-CHANCE-API-020\nThe treasure chest disappears completely in Xsolla's API: “open loot box” is a remote state mutation with three identifiers.",shape=box,style="rounded,filled",fillcolor="white"];
ne2c5c5d933cd [label="MINECRAFT-GAMBLING-021\nMinecraft bans “gambling” as an all-ages world-content failure while separately engineering currencies so they cannot escape the server.",shape=box,style="rounded,filled",fillcolor="white"];
n90dfa62ef288 [label="WORLD-MEMBRANE-022\nThe boundary of the virtual world is part of the gambling machine.",shape=box,style="rounded,filled",fillcolor="white"];
n1295960fb9fd [label="A program can be a choreography of state transformations",shape=ellipse,style="filled",fillcolor="#eeeeea"];
nccf0b00492e0 [label="A world can exceed its rendering",shape=ellipse,style="filled",fillcolor="#eeeeea"];
